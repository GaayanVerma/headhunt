# LinkedIn credentials for scraping
# Copy this file to .env and fill in your credentials

# Use either LINKEDIN_EMAIL or LINKEDIN_USERNAME (both work)
LINKEDIN_EMAIL=your.email@example.com
# LINKEDIN_USERNAME=your.email@example.com

LINKEDIN_PASSWORD=your_password_here

# ---------------------------------------------------------------------------
# GitHub API token for GitHubAnalyzer / GitHubAIAnalyzer (candidate GitHub
# profile/repo/contribution analysis).
#
# Optional but strongly recommended: without it, GraphQL is unusable (GitHub
# requires auth for the GraphQL API), so:
#   - GitHubAnalyzer falls back to unauthenticated REST at 60 req/hr, with
#     hygiene signals (CI/tests/docker/lint/readme) and per-repo
#     language/release data skipped entirely.
#   - GitHubAIAnalyzer's contribution analysis (contributionsCollection is
#     GraphQL-only) is skipped entirely, and repo-insight file/tree fetches
#     run at the same 60 req/hr unauthenticated REST budget.
#
# How to get one:
#   1. Go to https://github.com/settings/tokens
#   2. Generate a fine-grained token (recommended) or a classic token
#   3. No special scopes are needed for public-data analysis - a token with
#      no scopes selected (classic) or only "Public Repositories" read access
#      (fine-grained) is sufficient, since this pipeline never accesses
#      private repos.
GITHUB_TOKEN=your_github_personal_access_token_here

# ---------------------------------------------------------------------------
# Anthropic API key for GitHubAIAnalyzer's LLM-assisted repository insight
# generation (repo_summary, workflow_summary, architecture_summary,
# code_quality signals).
#
# Optional: without it, GitHubAIAnalyzer still runs the deterministic
# GitHubAnalyzer pipeline and contribution analysis, but skips repo insight
# generation entirely (llm_repo_insights.limitations will note this).
#
# How to get one:
#   1. Go to https://console.anthropic.com/settings/keys
#   2. Sign in / create an Anthropic account, add billing if prompted
#   3. Click "Create Key" and paste the value below
ANTHROPIC_API_KEY=your_anthropic_api_key_here
